# ---------- App ----------
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# ---------- Supabase ----------
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NUNCA expor no navegador. Usada só em rotas do servidor (webhooks, envio).
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Asaas (assinatura) ----------
ASAAS_API_KEY=
# sandbox: https://api-sandbox.asaas.com/v3   produção: https://api.asaas.com/v3
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Token definido por você no painel do Asaas > Integrações > Webhooks
ASAAS_WEBHOOK_TOKEN=
# Valor mensal do plano em centavos (ex.: 19700 = R$ 197,00)
PLAN_PRICE_CENTS=19700
PLAN_NAME=Plano Profissional

# ---------- WhatsApp API oficial (Meta Cloud API) ----------
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ---------- WhatsApp QR Code (Evolution API v2) ----------
EVOLUTION_API_URL=https://evolution.seu-dominio.com.br
EVOLUTION_API_KEY=

# ---------- Comandos por voz ----------
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---------- Google Agenda (OAuth) ----------
# Google Cloud > APIs e serviços > Credenciais > ID do cliente OAuth (Aplicativo da Web)
# URI de redirecionamento autorizado: <NEXT_PUBLIC_APP_URL>/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
